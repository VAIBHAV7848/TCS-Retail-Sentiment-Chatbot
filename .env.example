# LLM Provider
GROQ_API_KEY=your_groq_api_key_here
# Optional fallback providers
GEMINI_API_KEY=
OPENAI_API_KEY=

# App
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO

# Database
DATABASE_URL=sqlite+aiosqlite:///./data/app.db
VAULT_DATABASE_URL=sqlite+aiosqlite:///./data/vault.db

# PII Vault encryption
VAULT_ENCRYPTION_KEY=

# Model settings
SENTIMENT_MODEL=cardiffnlp/twitter-roberta-base-sentiment-latest
EMOTION_MODEL=j-hartmann/emotion-english-distilroberta-base
SPACY_MODEL=en_core_web_sm

# Tier-2 LLM
TIER2_CONFIDENCE_THRESHOLD=0.70
TIER2_MODEL=gemini-2.0-flash

# Response LLM
RESPONSE_MODEL_FAST=gemini-2.0-flash
RESPONSE_MODEL_STRONG=gemini-2.0-flash

# Frontend
VITE_API_URL=http://localhost:8000
