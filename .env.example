# LLM Provider Configuration
LLM_PROVIDER=ollama                # "ollama" (100% local, no external API keys) or "groq"
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b

# Optional Cloud LLM Fallback (only used if LLM_PROVIDER=groq or as failover)
GROQ_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=

# App
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO

# Database (SQLite with WAL mode)
DATABASE_URL=sqlite+aiosqlite:///./data/app.db
VAULT_DATABASE_URL=sqlite+aiosqlite:///./data/vault.db

# PII Vault encryption (Fernet key, optional - defaults to ephemeral dev key if unset)
VAULT_ENCRYPTION_KEY=

# Model settings (Local HuggingFace & spaCy)
SENTIMENT_MODEL=cardiffnlp/twitter-roberta-base-sentiment-latest
EMOTION_MODEL=j-hartmann/emotion-english-distilroberta-base
SPACY_MODEL=en_core_web_sm

# Tier-2 LLM
TIER2_CONFIDENCE_THRESHOLD=0.70
TIER2_MODEL=gemini-2.0-flash

# Response LLM
RESPONSE_MODEL_FAST=gemini-2.0-flash
RESPONSE_MODEL_STRONG=gemini-2.0-flash

# RAG (optional lightweight retrieval, fail-open)
RAG_ENABLED=true
RAG_TOP_K=3

# Frontend
VITE_API_URL=http://localhost:8000
